# Copy this file to .env and edit it. .env is not committed.
# After changing MODEL or PROMPT_FILE:  docker compose up -d triage

# The candidate model the service uses. Must match a tag in models/candidates.txt.
MODEL=qwen2.5:0.5b

# Prompt template in service/prompts/. Change the version only before benchmarking starts.
PROMPT_FILE=classify_v1.txt

# Generation options (logged with every request).
NUM_CTX=4096
TEMPERATURE=0
SEED=42
OLLAMA_TIMEOUT_S=600

# Ollama server settings. Record these in the test environment description.
# Assignment 2: a cascade needs every model it calls resident at once. Set OLLAMA_MAX_LOADED_MODELS
# to the number of models the cascade uses (2, or 3 for RULE=agreement) and keep it the SAME for
# every A2 configuration, single models included. After changing it: docker compose up -d ollama
OLLAMA_IMAGE=ollama/ollama:0.35.1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=512
OLLAMA_KEEP_ALIVE=30m

# --- Assignment 2 cascade (see docs/a2-playbook.md) ---
# MODE=single uses MODEL above, exactly as in Assignment 1.
# MODE=cascade ignores MODEL: SMALL_MODEL answers first, RULE decides whether to escalate to LARGE_MODEL.
MODE=single
#SMALL_MODEL=llama3.2:1b-instruct-q4_K_M
#LARGE_MODEL=qwen2.5:7b
# RULE: category | length | agreement
#RULE=category
# Label written to the log so the two settings can be told apart, e.g. A or B
#RULE_SETTING=A
# category: accept the small model's answer when it PREDICTS one of these (comma-separated, exact names)
#ACCEPT_CATEGORIES=Mortgage,Credit card
# length: accept when the narrative has at most this many characters
#LENGTH_MAX_CHARS=600
# agreement: also ask AGREE_MODEL; accept when both small models agree
# (and, if ACCEPT_CATEGORIES is set, only when the shared answer is one of them)
#AGREE_MODEL=qwen2.5:0.5b
